

def update_manifest(root: Path, firmware: Path | None = None) -> None:
    manifest_path = root / "RELEASE-MANIFEST.json"
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    manifest["version"] = VERSION
    manifest["source_date_epoch"] = SOURCE_DATE_EPOCH
    manifest["artifact"] = {
        "filename": f"Flight-Commander-Firmware-{VERSION}-MICOAIR743.hex",
        "sha256": digest(firmware) if firmware else "0" * 64,
        "bytes": firmware.stat().st_size if firmware else 0,
    }
    manifest["heading_source_liveness"] = {
        "driver_recovery": (
            "Retains the reviewed 4.0.4 75 ms conversion timeout and nonblocking "
            "IST8310 reset/reconfiguration path."
        ),
        "freshness": "sample age is independent from heading validity and field quality",
        "field_quality": (
            "fresh finite magnetic headings remain available at displayed quality 0; "
            "a one-percent authority floor keeps a single-source fused heading defined "
            "without concealing the warning or outweighing a better source"
        ),
        "startup_yaw": (
            "four consecutive fresh fused samples within 5 degrees seed yaw once "
            "while disarmed using a dedicated Flight Commander initialization state"
        ),
        "disabled_source_weight": (
            "reset, runtime migration and MSP writes normalize every disabled source "
            "weight to zero"
        ),
    }
    clean_bytecode(root)
    revision, tree = source_identities(root)
    manifest["source_revision"] = revision
    manifest["source_tree"] = tree
    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8", newline="\n")


def verify_source(root: Path) -> None:
    clean_bytecode(root)
    sys.dont_write_bytecode = True
    namespace: dict[str, object] = {}
    verifier = root / "flight-commander/verify-release.py"
    exec(compile(verifier.read_text(encoding="utf-8"), str(verifier), "exec"), namespace)
    namespace["verify_source"](root)


def create_source_zip(root: Path, destination: Path) -> None:
    manifest = json.loads((root / "RELEASE-MANIFEST.json").read_text(encoding="utf-8"))
    stamp = time.gmtime(manifest["source_date_epoch"])[:6]
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.unlink(missing_ok=True)
    clean_bytecode(root)
    with zipfile.ZipFile(destination, "w", zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
        for path in sorted(root.rglob("*")):
            if not path.is_file():
                continue
            relative = Path(root.name) / path.relative_to(root)
            info = zipfile.ZipInfo(relative.as_posix(), stamp)
            info.create_system = 3
            mode = 0o755 if path.suffix in {".sh", ".py"} else 0o644
            info.external_attr = (stat.S_IFREG | mode) << 16
            info.compress_type = zipfile.ZIP_DEFLATED
            archive.writestr(
                info,
                path.read_bytes(),
                compress_type=zipfile.ZIP_DEFLATED,
                compresslevel=9,
            )


def prepare(root: Path) -> Path:
    root = rename_root(root)
    patch_version(root)
    patch_heading_defaults_and_liveness(root)
    patch_startup_seed(root)
    patch_verifier_contract(root)
    update_reviewed_baseline(root)
    update_manifest(root)
    verify_source(root)
    return root


def finalize(root: Path, firmware: Path, source_zip: Path) -> None:
    if root.name != f"Flight-Commander-Firmware-Source-v{VERSION}":
        raise RuntimeError(f"Unexpected source root: {root}")
    if not root.is_dir() or not firmware.is_file():
        raise RuntimeError("Prepared source root or compiled firmware is missing")
    update_manifest(root, firmware)
    verify_source(root)
    create_source_zip(root, source_zip)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--prepared-4.0.4-root", dest="prepared_root", type=Path)
    parser.add_argument("--finalize-root", type=Path)
    parser.add_argument("--firmware", type=Path)
    parser.add_argument("--source-zip", type=Path)
    args = parser.parse_args()

    preparing = args.prepared_root is not None
    finalizing = args.finalize_root is not None or args.firmware is not None or args.source_zip is not None
    if preparing == finalizing:
        parser.error("select exactly one of prepare or finalize mode")

    if preparing:
        print(prepare(args.prepared_root.resolve()))
        return

    if args.finalize_root is None or args.firmware is None or args.source_zip is None:
        parser.error("finalize mode requires --finalize-root, --firmware, and --source-zip")
    finalize(args.finalize_root.resolve(), args.firmware.resolve(), args.source_zip.resolve())
    print(args.source_zip.resolve())


if __name__ == "__main__":
    main()
