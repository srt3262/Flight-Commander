        };
    }

    if (magnetic && quality === 0) {
        return {
            reason: 'field-quality-low',
            label: `Fresh magnetic sample · field quality 0% · ${ageMs} ms`,
            stateClass: 'is-warning',
            ageMs,
            quality,
        };
    }

    return {
        reason: 'fresh-rejected',
        label: `Fresh sample rejected · Q${quality}% · ${ageMs} ms`,
        stateClass: 'is-warning',
        ageMs,
        quality,
    };
}

