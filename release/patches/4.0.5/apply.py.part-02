export function clearDisabledHeadingSourceWeights(config) {
    if (!Array.isArray(config?.sources)) return false;
    let changed = false;
    for (const source of config.sources) {
        if (source && !source.enabled && Number(source.weight) !== 0) {
            source.weight = 0;
            changed = true;
        }
    }
    return changed;
}

