+                        magnetic: sourceIndex < HEADING_SOURCE_MOVING_BASELINE,
+                    }).label;
                 }
-                if (source && source.ageMs !== 0xffff) {
+                if (appendAge && source && source.ageMs !== 0xffff) {
                     label += ` · ${source.ageMs} ms`;
                 }
                 $(`#headingSourceStatus${sourceIndex}`).text(label);
