tree = source_identities(root)
    if revision != EXPECTED_REVISION:
        raise RuntimeError(f"Unexpected reviewed source revision: {revision}")
    if tree != EXPECTED_TREE:
        raise RuntimeError(f"Unexpected reviewed source tree: {tree}")
    manifest["source_revision"] = revision
    manifest["source_tree"] = tree
    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")


def verify_source(root: Path) -> None:
    clean_bytecode(root)
    sys.dont_write_bytecode = True
    namespace: dict[str, object] = {}
    verifier = root / "flight-commander/verify-release.py"
    exec(compile(verifier.read_text(encoding="utf-8"), str(verifier), "exec"), namespace)
    namespace["verify_source"](root)


def create_source_zip(root: Path, destination: Path) -> None:
    manifest = json.loads((root / "RELEASE-MANIFEST.json").read_text(encoding="utf-8"))
    stamp = time.gmtime(manifest["source_date_epoch"])[:6]
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.unlink(missing_ok=True)
    clean_bytecode(root)
    with zipfile.ZipFile(destination, "w", zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
        for path in sorted(root.rglob("*")):
            if not path.is_file():
                continue
            relative = Path(root.name) / path.relative_to(root)
            info = zipfile.ZipInfo(relative.as_posix(), stamp)
            info.create_system = 3
            mode = 0o755 if path.suffix in {".sh", ".py"} else 0o644
            info.external_attr = (stat.S_IFREG | mode) << 16
            info.compress_type = zipfile.ZIP_DEFLATED
            archive.writestr(
                info,
                path.read_bytes(),
                compress_type=zipfile.ZIP_DEFLATED,
                compresslevel=9,
            )


def prepare(archive: Path, output: Path, patch: Path) -> Path:
    root = extract_archive(archive, output)
    apply_patch(root, patch)
    update_reviewed_baseline(root)
    update_manifest(root)
    verify_source(root)
    return root


def finalize(root: Path, firmware: Path, source_zip: Path) -> None:
    if not root.is_dir() or not firmware.is_file():
        raise RuntimeError("Prepared source root or compiled firmware is missing")
    update_manifest(root, firmware)
    verify_source(root)
    create_source_zip(root, source_zip)


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--archive", type=Path)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--patch", type=Path)
    parser.add_argument("--finalize-root", type=Path)
    parser.add_argument("--firmware", type=Path)
    parser.add_argument("--source-zip", type=Path)
    args = parser.parse_args()

    preparing = args.archive is not None or args.output is not None or args.patch is not None
    finalizing = args.finalize_root is not None or args.firmware is not None or args.source_zip is not None
    if preparing == finalizing:
        parser.error("select exactly one of prepare or finalize mode")

    if preparing:
        if args.archive is None or args.output is None or args.patch is None:
            parser.error("prepare mode requires --archive, --output, and --patch")
        print(prepare(args.archive.resolve(), args.output.resolve(), args.patch.resolve()))
        return

    if args.finalize_root is None or args.firmware is None or args.source_zip is None:
        parser.error("finalize mode requires --finalize-root, --firmware, and --source-zip")
    finalize(args.finalize_root.resolve(), args.firmware.resolve(), args.source_zip.resolve())
    print(args.source_zip.resolve())


if __name__ == "__main__":
    main()
