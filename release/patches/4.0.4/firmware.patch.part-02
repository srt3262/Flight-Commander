+bool flightCommanderHeadingGetFusedHeading(uint16_t *headingCentidegrees)
+{
+    if (!headingCentidegrees || headingStatus.activeMask == 0 ||
+        headingStatus.anchorSource >= FLIGHT_COMMANDER_HEADING_SOURCE_COUNT) {
+        return false;
+    }
+
+    // A direct startup quaternion seed is intentionally stricter than normal
+    // soft AHRS weighting. Moving-baseline data already passed its accuracy and
+    // fixed-solution gates; magnetic sources need modest field plausibility so
+    // a severely disturbed sample cannot instantly redefine north.
+    if (headingStatus.anchorSource < FLIGHT_COMMANDER_HEADING_MOVING_BASELINE &&
+        headingStatus.sources[headingStatus.anchorSource].quality <
+            FLIGHT_COMMANDER_MAG_STARTUP_MIN_FIELD_QUALITY) {
+        return false;
+    }
+
+    *headingCentidegrees = headingStatus.fusedHeadingCentidegrees;
+    return true;
