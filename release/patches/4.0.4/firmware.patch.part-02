+}
+
+bool compassIsHealthy(void)
+{
+    return compassGetSampleAgeMs() <= COMPASS_SAMPLE_TIMEOUT_US / 1000U &&
+        ((mag.magADC[X] != 0) || (mag.magADC[Y] != 0) || (mag.magADC[Z] != 0));
 }
 
