diff --git a/CMakeLists.txt b/CMakeLists.txt
index a6b5b4d..9d47e9c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -90,7 +90,7 @@ set(FIRMWARE_VERSION ${PROJECT_VERSION})
 
 # Flight Commander release identity is independent from the inherited INAV
 # protocol compatibility version declared by project().
-set(FLIGHT_COMMANDER_FIRMWARE_VERSION 4.0.3)
+set(FLIGHT_COMMANDER_FIRMWARE_VERSION 4.0.4)
 
 option(WARNINGS_AS_ERRORS "Make all warnings into errors")
 message("-- toolchain: ${TOOLCHAIN}, WARNINGS_AS_ERRORS: ${WARNINGS_AS_ERRORS}")
diff --git a/flight-commander/build-micoair743.sh b/flight-commander/build-micoair743.sh
index 7bd84ae..79def73 100755
--- a/flight-commander/build-micoair743.sh
+++ b/flight-commander/build-micoair743.sh
@@ -65,7 +65,7 @@ cmake -S "${source_root}" -B "${build_dir}" -G Ninja \
     -DFLIGHT_COMMANDER_SOURCE_REVISION="${source_revision}"
 cmake --build "${build_dir}" --target MICOAIR743
 
-hex="${build_dir}/Flight-Commander-Firmware-4.0.3-MICOAIR743.hex"
+hex="${build_dir}/Flight-Commander-Firmware-4.0.4-MICOAIR743.hex"
 python3 "${source_root}/flight-commander/verify-compass-release.py" "${hex}"
 
 echo "Built and verified: ${hex}"
diff --git a/flight-commander/verify-compass-release.py b/flight-commander/verify-compass-release.py
index 382e1f8..67b8188 100755
--- a/flight-commander/verify-compass-release.py
+++ b/flight-commander/verify-compass-release.py
@@ -1,5 +1,5 @@
 #!/usr/bin/env python3
-"""Structural verification for the Flight Commander 4.0.3 compass release build."""
+"""Structural verification for the Flight Commander 4.0.4 compass release build."""
 
 from __future__ import annotations
 
@@ -7,7 +7,7 @@ import hashlib
 from pathlib import Path
 import sys
 
-EXPECTED_IDENTITY = b"FCFW" + bytes((1, 4, 0, 3, 9, 1, 0, 0xFF, 0x3F, 0, 0))
+EXPECTED_IDENTITY = b"FCFW" + bytes((1, 4, 0, 4, 9, 1, 0, 0xFF, 0x3F, 0, 0))
 EXPECTED_TARGET = b"MICOAIR743"
 
 
@@ -66,7 +66,7 @@ def main() -> int:
     path = Path(sys.argv[1]).resolve()
     memory = parse_intel_hex(path)
     if not contains(memory, EXPECTED_IDENTITY):
-        fail("HEX does not contain the Flight Commander 4.0.3 identity")
+        fail("HEX does not contain the Flight Commander 4.0.4 identity")
     if not contains(memory, EXPECTED_TARGET):
         fail("HEX does not contain the MICOAIR743 target identity")
     digest = hashlib.sha256(path.read_bytes()).hexdigest()
diff --git a/flight-commander/verify-release.py b/flight-commander/verify-release.py
index 8fef1fc..979ad22 100755
--- a/flight-commander/verify-release.py
+++ b/flight-commander/verify-release.py
@@ -1,6 +1,6 @@
 #!/usr/bin/env python3
 
-"""Verify the Flight Commander 4.0.3 MICOAIR743 source and HEX contract."""
+"""Verify the Flight Commander 4.0.4 MICOAIR743 source and HEX contract."""
 
 from __future__ import annotations
 
@@ -13,11 +13,11 @@ import re
 import sys
 
 
