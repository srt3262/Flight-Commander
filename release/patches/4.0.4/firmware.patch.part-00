-EXPECTED_IDENTITY = b"FCFW" + bytes((1, 4, 0, 3, 9, 1, 0, 0xFF, 0x3F, 0, 0))
+EXPECTED_IDENTITY = b"FCFW" + bytes((1, 4, 0, 4, 9, 1, 0, 0xFF, 0x3F, 0, 0))
 
 
 def fail(message: str) -> None:
@@ -214,14 +214,14 @@ def verify_source(root: Path) -> None:
     verify_upstream_baseline(root)
     require_text(
         root / "CMakeLists.txt",
-        [r"set\(FLIGHT_COMMANDER_FIRMWARE_VERSION 4\.0\.3\)", r"FLIGHT_COMMANDER_SOURCE_REVISION"],
+        [r"set\(FLIGHT_COMMANDER_FIRMWARE_VERSION 4\.0\.4\)", r"FLIGHT_COMMANDER_SOURCE_REVISION"],
     )
     require_text(
         root / "src/main/build/flight_commander.h",
         [
             r"FLIGHT_COMMANDER_VERSION_MAJOR 4",
             r"FLIGHT_COMMANDER_VERSION_MINOR 0",
-            r"FLIGHT_COMMANDER_VERSION_PATCH 3",
+            r"FLIGHT_COMMANDER_VERSION_PATCH 4",
             r"FLIGHT_COMMANDER_CAPABILITIES \(\(uint32_t\)0x3FFFU\)",
         ],
     )
@@ -250,6 +250,9 @@ def verify_source(root: Path) -> None:
             r"flightCommanderHeadingGetOnboardMagWeight",
             r"Source quality already contains INAV's field-magnitude nearness",
             r"flightCommanderHeadingGetAbsoluteReference",
+            r"flightCommanderHeadingGetFusedHeading",
+            r"imuComputeQuaternionFromRPY",
+            r"resetHeadingHoldTarget\(CENTIDEGREES_TO_DEGREES\(fusedHeadingCentidegrees\)\)",
         ],
     )
     reject_text(
@@ -276,7 +279,11 @@ def verify_source(root: Path) -> None:
             r"config->sources\[2\] = \(flightCommanderHeadingSourceConfig_t\)\{ false, 3, 50, 0 \}",
             r"config->sources\[3\] = \(flightCommanderHeadingSourceConfig_t\)\{ false, 4, 25, 0 \}",
             r"magneticFieldQuality",
-            r"FLIGHT_COMMANDER_MAG_MIN_FIELD_QUALITY 25U",
+            r"FLIGHT_COMMANDER_MAG_MIN_FIELD_QUALITY 1U",
+            r"FLIGHT_COMMANDER_MAG_STARTUP_MIN_FIELD_QUALITY 10U",
+            r"sample->hasMeasurement \? now - sample->updatedAtMs : UINT32_MAX",
+            r"const uint16_t onboardAgeMs = compassGetSampleAgeMs\(\)",
+            r"flightCommanderHeadingGetFusedHeading",
             r"magneticFieldToTrueHeading",
             r"fieldEarth\.x \* correctedMagneticNorthEarth\.y",
             r"DECIDEGREES_TO_CENTIDEGREES\(attitude\.values\.yaw\)",
@@ -311,11 +318,29 @@ def verify_source(root: Path) -> None:
         root / "src/main/common/maths.c",
         [r"if \(!isfinite\(result\[i\]\)\)"],
     )
+    require_text(
+        root / "src/main/fc/fc_tasks.c",
+        [r"rescheduleTask\(TASK_COMPASS, TASK_PERIOD_HZ\(40\)\)"],
+    )
+    reject_text(
+        root / "src/main/flight_commander/heading_fusion.c",
+        [r"FLIGHT_COMMANDER_MAG_MIN_FIELD_QUALITY 25U"],
+    )
+    reject_text(
+        root / "src/main/drivers/compass/compass_ist8310.c",
+        [r"IST8310_DATA_READY_RETRY_LIMIT"],
+    )
     require_text(
         root / "src/main/drivers/compass/compass_ist8310.c",
         [
             r"IST8310_STATUS1_DRDY",
             r"IST8310_ODR_SINGLE",
+            r"IST8310_CONVERSION_TIMEOUT_MS 75U",
+            r"IST8310_FULL_RESET_AFTER_TIMEOUTS 2U",
+            r"busReadBuf\(mag->busDev, IST8310_REG_STATUS1, frame",
+            r"ist8310BeginRuntimeReset",
+            r"ist8310ServiceRuntimeReset",
+            r"The reset is serviced across later task calls",
             r"mag->magADCRaw\[X\] = -nativeY \* IST8310_LSB_TO_MILLIGAUSS",
             r"mag->magADCRaw\[Y\] = -nativeX \* IST8310_LSB_TO_MILLIGAUSS",
             r"mag->magADCRaw\[Z\] =  nativeZ \* IST8310_LSB_TO_MILLIGAUSS",
@@ -331,6 +356,7 @@ def verify_source(root: Path) -> None:
             r"magCalibrationRevision",
             r"magCalibrationSignature",
             r"compassCalibrationSignature",
+            r"compassGetSampleAgeMs",
             r"\.mag_align = COMPASS_RESET_ALIGN",
         ],
     )
@@ -364,7 +390,7 @@ def main() -> int:
     digest = sha256(hex_path)
     memory, record_count = parse_intel_hex(hex_path)
     if not contains_contiguous(memory, EXPECTED_IDENTITY):
-        fail("HEX does not contain the exact FCFW 4.0.3 / INAV 9.1.0 / 0x1FFF identity payload")
+        fail("HEX does not contain the exact FCFW 4.0.4 / INAV 9.1.0 / 0x1FFF identity payload")
     if not contains_contiguous(memory, TARGET.encode("ascii")):
         fail(f"HEX does not contain the {TARGET} target identity")
 
diff --git a/src/main/build/flight_commander.h b/src/main/build/flight_commander.h
index 20cb8f4..91573a2 100644
--- a/src/main/build/flight_commander.h
+++ b/src/main/build/flight_commander.h
@@ -13,7 +13,7 @@
 
