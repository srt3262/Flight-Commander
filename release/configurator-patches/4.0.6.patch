+    releaseFor("4.0.4", "4"),
+    releaseFor("4.0.5", "5"),
+    releaseFor("4.0.6", "a"),
+  ]);
+  assert.deepEqual(descriptors.map(({ version }) => version), ["4.0.6", "3.0.7"]);
+});
