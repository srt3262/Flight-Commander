        if (!/^\$G[A-Z]GGA,[^\r\n]*\*[0-9A-F]{2}$/i.test(value)) {
          return { error: true, msg: 'Invalid NMEA GGA sentence.' };
        }
        this.socket.write(`${value}\r\n`);
