      if (
        peOffset + 6 > bytes.length ||
        bytes.toString("ascii", peOffset, peOffset + 4) !== "PE\u0000\u0000"
      ) {
        fail(`${path} has an invalid PE header`);
      }
      return bytes.readUInt16LE(peOffset + 4);
    }
    
