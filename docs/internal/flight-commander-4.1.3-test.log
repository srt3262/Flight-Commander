      firmware:
        name: Rebuild firmware from retained source ZIP
        if: >-
          github.ref == 'refs/heads/main' &&
          (
            github.event_name == 'workflow_dispatch' ||
            (
              github.event_name == 'push' &&
              github.event.head_commit.message == 'Publish Flight Commander 3.0.3 release'
            )
          )
        runs-on: ubuntu-latest
        timeout-minutes: 30
        permissions:
          contents: read
    
        steps:
          - name: Check out exact release source
            uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
            with:
              ref: ${{ github.event_name == 'workflow_dispatch' && inputs.expected_sha || github.sha }}
              fetch-depth: 1
              persist-credentials: false
    
          - name: Verify exact release revision
            env:
              EXPECTED_SHA: ${{ github.event_name == 'workflow_dispatch' && inputs.expected_sha || github.sha }}
            run: |
              set -euo pipefail
              [[ "${EXPECTED_SHA}" =~ ^[0-9a-f]{40}$ ]]
              [[ "$(git rev-parse HEAD)" == "${EXPECTED_SHA}" ]]
    
          - name: Set up Node.js
            uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
