diff --git a/flight-commander/verify-compass-release.py b/flight-commander/verify-compass-release.py
index 1164408..0e0235d 100644
--- a/flight-commander/verify-compass-release.py
+++ b/flight-commander/verify-compass-release.py
@@ -1,5 +1,5 @@
 #!/usr/bin/env python3
-"""Structural verification for the Flight Commander 3.0.4 compass build."""
+"""Structural verification for the Flight Commander 3.0.5 compass build."""
 
 from __future__ import annotations
 
@@ -7,7 +7,7 @@ import hashlib
 from pathlib import Path
 import sys
 
-EXPECTED_IDENTITY = b"FCFW" + bytes((1, 3, 0, 4, 9, 1, 0, 0xFF, 0x1F, 0, 0))
+EXPECTED_IDENTITY = b"FCFW" + bytes((1, 3, 0, 5, 9, 1, 0, 0xFF, 0x1F, 0, 0))
 EXPECTED_TARGET = b"MICOAIR743"
 
 
@@ -66,7 +66,7 @@ def main() -> int:
     path = Path(sys.argv[1]).resolve()
     memory = parse_intel_hex(path)
     if not contains(memory, EXPECTED_IDENTITY):
-        fail("HEX does not contain the Flight Commander 3.0.4 identity")
+        fail("HEX does not contain the Flight Commander 3.0.5 identity")
     if not contains(memory, EXPECTED_TARGET):
         fail("HEX does not contain the MICOAIR743 target identity")
     digest = hashlib.sha256(path.read_bytes()).hexdigest()
