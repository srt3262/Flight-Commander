diff --git a/flight-commander/build-micoair743.sh b/flight-commander/build-micoair743.sh
index 67b294b..c3388fe 100755
--- a/flight-commander/build-micoair743.sh
+++ b/flight-commander/build-micoair743.sh
@@ -65,7 +65,7 @@ cmake -S "${source_root}" -B "${build_dir}" -G Ninja \
