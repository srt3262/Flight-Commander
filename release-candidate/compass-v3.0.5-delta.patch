diff --git a/src/main/drivers/compass/compass_ist8310.c b/src/main/drivers/compass/compass_ist8310.c
index 743041e..10e072a 100644
--- a/src/main/drivers/compass/compass_ist8310.c
+++ b/src/main/drivers/compass/compass_ist8310.c
@@ -124,11 +124,12 @@ static void ist8310StoreSample(magDev_t *mag, int16_t nativeX, int16_t nativeY,
         mag->busDev->busdev.i2c.address == 0x0E;
 
     if (isMicoAirOnboard) {
-        // MicoAir743 PCB mapping, matching the board definition used by
-        // ArduPilot: IST8310 native right-hand conversion followed by YAW_90.
+        // Bench-confirmed MICOAIR743 mapping. Firmware 3.0.4 proved the
+        // level-plane axes (-Y, X), but physical roll/pitch testing showed that
+        // native Z is already aligned with INAV body-down Z.
         mag->magADCRaw[X] = -nativeY * IST8310_LSB_TO_MILLIGAUSS;
         mag->magADCRaw[Y] =  nativeX * IST8310_LSB_TO_MILLIGAUSS;
-        mag->magADCRaw[Z] = -nativeZ * IST8310_LSB_TO_MILLIGAUSS;
+        mag->magADCRaw[Z] =  nativeZ * IST8310_LSB_TO_MILLIGAUSS;
         return;
     }
 #endif
